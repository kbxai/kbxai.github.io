---
import Base from '../../layouts/Base.astro';
import ProjectFigure from '../../components/ProjectFigure.astro';
import ProjectShot from '../../components/ProjectShot.astro';
import projects from '../../data/projects.json';
import profile from '../../data/profile.json';
import { arrow } from '../../lib/icons';

export function getStaticPaths() {
  return projects.map((p) => ({ params: { slug: p.slug }, props: { p } }));
}
const { p } = Astro.props as { p: (typeof projects)[number] };
const i = projects.findIndex((x) => x.slug === p.slug);
const next = projects[(i + 1) % projects.length]!;
const isLive = p.metric.label === 'live';
---
<Base title={`${p.title} | Kartik Bajaj`} description={`${p.summary} ${p.context}, ${p.dates}.`}>
  <article class="wrap proj" aria-labelledby="t">
    <p class="back"><a class="link" href="/#work">All work</a></p>
    <header class="head">
      <p class="meta"><span>{p.context}</span><span class="dim">{p.dates}</span></p>
      <h1 id="t">{p.title}</h1>
      <p class="sum">{p.summary}</p>
      <p class="actions">
        {p.links.demo && <a class="btn solid" href={p.links.demo}>Open the live demo<Fragment set:html={arrow} /></a>}
        <a class={p.links.demo ? 'link' : 'btn solid'} href={p.links.github}>Source on GitHub</a>
      </p>
    </header>

    {p.links.demo && <div class="hero-shot"><ProjectShot slug={p.slug} demo={p.links.demo} title={p.title} eager /></div>}

    <div class="grid">
      <div class="facts">
        <dl class="kv">
          <dt>Result</dt><dd>{isLive ? `Live ${p.metric.value}` : <span class="accent">{p.metric.label} {p.metric.value}</span>}</dd>
          <dt>Stack</dt><dd>{p.stack.join(', ')}</dd>
          <dt>Context</dt><dd>{p.context}</dd>
          <dt>When</dt><dd>{p.dates}</dd>
        </dl>
      </div>
      <div class="figure-wrap"><ProjectFigure slug={p.slug} results={p.results} /></div>
    </div>

    <section aria-labelledby="what">
      <h2 id="what" data-reveal>What I built</h2>
      <ul class="bullets">{p.bullets.map((b) => <li>{b}</li>)}</ul>
    </section>

    {p.results.length > 0 && (
      <section aria-labelledby="res">
        <h2 id="res" data-reveal>Results</h2>
        <div class="table-scroll">
          <table class="data">
            <thead><tr><th scope="col">Model or setup</th><th scope="col" style="text-align:right">Macro F1</th></tr></thead>
            <tbody>{p.results.map((r) => <tr><td>{r.model}</td><td class="num">{r.score}</td></tr>)}</tbody>
          </table>
        </div>
      </section>
    )}

    <section aria-labelledby="lim">
      <h2 id="lim" data-reveal>Limits</h2>
      <ul class="bullets">{p.limitations.map((l) => <li>{l}</li>)}</ul>
      <p class="note muted">{profile.aiAssisted}</p>
    </section>

    <a class="next" href={`/projects/${next.slug}/`}>
      <span class="dim">Next project</span>
      <span class="next-title">{next.title}</span>
    </a>
  </article>
</Base>
<style>
  .proj { padding-top: calc(68px + clamp(2rem, 6vw, 4rem)); }
  .back { margin-bottom: clamp(2rem, 5vw, 3.5rem); font-size: var(--fs-sm); }
  .meta { display: flex; flex-wrap: wrap; gap: 0.3rem 1.1rem; font-size: var(--fs-sm); color: var(--muted); margin-bottom: 1.4rem; }
  h1 { font-size: var(--fs-2xl); letter-spacing: -0.03em; max-width: 18ch; margin-bottom: 1.4rem; }
  .sum { font-size: var(--fs-lg); color: var(--muted); max-width: 46ch; margin-bottom: 2rem; }
  .hero-shot { margin-top: clamp(1rem, 3vw, 2rem); }
  .grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr); gap: 2rem 4rem; margin: clamp(3rem, 7vw, 5rem) 0; padding-top: 2.5rem; border-top: 1px solid var(--line); }
  .grid .kv { grid-template-columns: minmax(0, 7rem) minmax(0, 1fr); }
  section { margin-top: clamp(3rem, 7vw, 5rem); display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 2fr); gap: 1.5rem 4rem; padding-top: 2.5rem; border-top: 1px solid var(--line); }
  section h2 { font-size: var(--fs-xl); }
  section > :not(h2) { grid-column: 2; }
  .bullets { margin: 0; padding: 0; list-style: none; display: grid; gap: 1.1rem; }
  .bullets li { padding-left: 1.4rem; position: relative; max-width: 60ch; }
  .bullets li::before { content: ''; position: absolute; left: 0; top: 0.72em; width: 6px; height: 6px; border-radius: 50%; background: var(--accent); }
  .note { margin-top: 1.5rem; font-size: var(--fs-sm); max-width: 60ch; }
  .next { display: flex; flex-direction: column; gap: 0.5rem; margin-top: clamp(4rem, 9vw, 7rem); padding: 2.5rem 0 0; border-top: 1px solid var(--line); text-decoration: none; }
  .next-title { font-family: var(--serif); font-size: var(--fs-xl); letter-spacing: -0.02em; line-height: 1.05; transition: color var(--t-fast) var(--ease); }
  .next:hover .next-title { color: var(--accent); }
  @media (max-width: 860px) {
    .grid, section { grid-template-columns: 1fr; }
    section > :not(h2) { grid-column: 1; }
  }
</style>
