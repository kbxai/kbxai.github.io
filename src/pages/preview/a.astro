---
// Direction A: "The Paper" - the portfolio as an ML research paper.
import '@fontsource/instrument-serif/400.css';
import '@fontsource/instrument-serif/400-italic.css';
import '@fontsource/ibm-plex-mono/400.css';
import '@fontsource/ibm-plex-mono/500.css';
import Preview from '../../layouts/Preview.astro';
import Portrait from '../../components/Portrait.astro';
import profile from '../../data/profile.json';
import projects from '../../data/projects.json';
const edu = profile.education[0]!;
const rows = projects.map((p) => ({ title: p.title, ctx: p.context, metric: p.metric.label === 'live' ? 'live demo' : `${p.metric.label} ${p.metric.value}`, slug: p.slug }));
---
<Preview title="Preview A: The Paper | Kartik Bajaj">
  <div class="paper">
    <header class="meta">
      <span>kbxai / preprint</span><span>v2026.11</span><span>[cs.LG] [cs.SE]</span><span class="hide-sm">{profile.location}</span>
    </header>

    <main class="hero">
      <section class="text">
        <p class="kicker" data-scramble="600">Portfolio, rendered as a paper</p>
        <h1>Kartik Bajaj</h1>
        <p class="sub"><em>Building reliable LLM applications and noise-robust ML models</em></p>
        <p class="affil">{edu.institution} &middot; {edu.degree} &middot; <span class="mono">CGPA 8.04/10</span></p>

        <h2 class="label">Abstract</h2>
        <p class="abstract">
          I am a data science student seeking an <strong>AI/LLM Engineer internship</strong>. I build LLM applications with
          schema-validated output, including a live app that turns a resume and job description into an interview report.
          In a private IITM Deep Learning Kaggle competition I reached a <strong>Macro F1 of 0.954</strong> on noisy audio
          genre classification with an ensemble of ResNet-50 and an Audio Spectrogram Transformer.
        </p>
        <p class="cites">
          <a href="/resume/">[1] resume</a>
          <a href={profile.links.github}>[2] github</a>
          <a href={`mailto:${profile.email}`}>[3] email</a>
          <a href="/#projects">[4] projects</a>
        </p>
      </section>

      <figure class="fig">
        <div class="frame"><Portrait /></div>
        <figcaption><span class="mono">Fig. 1.</span> The author, drawn as glyphs from 478 facial landmarks, a cel-shaded tone map and a depth map. Move the cursor to perturb the signal.</figcaption>
      </figure>
    </main>

    <section class="table" aria-labelledby="t1">
      <p id="t1" class="caption"><span class="mono">Table 1.</span> Selected work.</p>
      <table>
        <thead><tr><th scope="col">Project</th><th scope="col">Context</th><th scope="col" class="r">Result</th></tr></thead>
        <tbody>{rows.map((r) => <tr><td><a href={`/projects/${r.slug}/`}>{r.title}</a></td><td>{r.ctx}</td><td class="r mono">{r.metric}</td></tr>)}</tbody>
      </table>
    </section>
  </div>
</Preview>

<style>
  :global(body) { background: #12110f; color: #e9e4d8; font-family: 'Instrument Serif', Georgia, serif; }
  .paper { max-width: 1180px; margin: 0 auto; padding: 0 24px 64px; }
  .mono, .meta, .kicker, .label, .cites, figcaption, .caption, th { font-family: 'IBM Plex Mono', ui-monospace, monospace; }
  .meta { display: flex; flex-wrap: wrap; gap: 6px 28px; padding: 18px 0; border-bottom: 1px solid #3a352d; font-size: 12px; letter-spacing: 0.06em; text-transform: uppercase; color: #a69e8d; }
  .hero { display: grid; grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr); gap: 56px; padding-top: 48px; align-items: start; }
  .kicker { font-size: 12px; letter-spacing: 0.14em; text-transform: uppercase; color: #ffb454; margin: 0 0 18px; }
  h1 { font-weight: 400; font-size: clamp(64px, 10vw, 132px); line-height: 0.9; letter-spacing: -0.02em; margin: 0; }
  .sub { font-size: clamp(22px, 2.6vw, 30px); line-height: 1.2; margin: 18px 0 10px; color: #d8d1c2; }
  .affil { font-size: 18px; color: #a69e8d; margin: 0 0 36px; }
  .label { font-size: 12px; letter-spacing: 0.14em; text-transform: uppercase; color: #a69e8d; font-weight: 500; margin: 0 0 10px; }
  .abstract { font-size: 21px; line-height: 1.5; margin: 0; max-width: 34em; }
  .abstract strong { font-weight: 400; color: #ffb454; font-style: italic; }
  .cites { display: flex; flex-wrap: wrap; gap: 10px 22px; margin-top: 28px; font-size: 14px; }
  .cites a { color: #7cff8a; text-decoration: none; border-bottom: 1px solid #2f5236; padding-bottom: 2px; }
  .cites a:hover { border-color: #7cff8a; }
  .fig { margin: 0; }
  .frame { border: 1px solid #3a352d; background: #0b0f0c; padding: 18px; }
  figcaption { font-size: 12px; line-height: 1.6; color: #a69e8d; margin-top: 12px; }
  .table { margin-top: 64px; }
  .caption { font-size: 12px; color: #a69e8d; margin: 0 0 8px; }
  table { width: 100%; border-collapse: collapse; font-size: 18px; border-top: 2px solid #e9e4d8; border-bottom: 2px solid #e9e4d8; }
  thead th { font-size: 12px; letter-spacing: 0.1em; text-transform: uppercase; font-weight: 500; text-align: left; padding: 10px 8px; border-bottom: 1px solid #e9e4d8; color: #a69e8d; }
  td { padding: 10px 8px; border-bottom: 1px solid #2a2620; }
  td a { color: #e9e4d8; text-decoration: none; }
  td a:hover { color: #7cff8a; }
  .r { text-align: right; white-space: nowrap; }
  td.mono { color: #ffb454; font-size: 15px; }
  @media (max-width: 860px) {
    .hero { grid-template-columns: 1fr; gap: 32px; padding-top: 32px; }
    .hide-sm { display: none; }
    td:nth-child(2), th:nth-child(2) { display: none; }
  }
</style>
