---
import Base from '../layouts/Base.astro';
import Portrait from '../components/Portrait.astro';
import ProjectRow from '../components/ProjectRow.astro';
import profile from '../data/profile.json';
import projects from '../data/projects.json';

const mm = projects.find((p) => p.slug === 'messy-mashup')!;
const [iitm, school] = profile.education as [(typeof profile.education)[number], (typeof profile.education)[number]];
const [first, ...rest] = profile.name.split(' ');
const sentence = (s: string) => s.replaceAll(' | ', '. ') + '.';
---
<Base
  preloadImage="/field/still.webp"
  title="Kartik Bajaj | AI/LLM Engineer intern | IIT Madras"
  description="Kartik Bajaj, IIT Madras BS Data Science student seeking an AI/LLM Engineer internship. Live LLM apps, a Macro F1 0.954 audio classifier, projects, resume and contact."
>
  <section class="hero" aria-labelledby="name">
    <div class="art"><Portrait /></div>
    <div class="wrap hero-copy">
      <p class="kicker rise" style="--d:0ms">{profile.headline.replace('Seeking: ', 'Seeking an ').replace('Internship', 'internship')}</p>
      <h1 id="name" class="name">
        <span class="line"><span class="rise" style="--d:40ms">{first}</span></span>
        <span class="line indent"><span class="rise" style="--d:100ms">{rest.join(' ')}</span></span>
      </h1>
      <p class="lead rise" style="--d:160ms">
        I build LLM apps and noise-robust ML models. My audio classifier scored a Macro F1 of{' '}<span class="accent">{mm.metric.value}</span>{' '}in a private IITM Kaggle competition, and three of my projects have live demos.
      </p>
      <div class="actions rise" style="--d:220ms">
        <a class="btn solid" href="/resume/">Read my resume</a>
        <a class="link" href={`mailto:${profile.email}`}>Email me</a>
      </div>
    </div>
  </section>

  <section id="work" class="block" aria-labelledby="work-title">
    <div class="wrap">
      <h2 id="work-title" class="section-title" data-reveal>Selected work</h2>
      <p class="section-lede">Five projects, in the same order as my resume. Each page shows what I measured and what is still missing.</p>
      <div class="rows" id="projects">
        {projects.map((p) => <ProjectRow project={p} />)}
      </div>
    </div>
  </section>

  <section id="about" class="block" aria-labelledby="about-title">
    <div class="wrap">
      <h2 id="about-title" class="section-title" data-reveal>About</h2>
      <div class="about">
        <div class="about-main">
          <p class="about-lead">
            I study Data Science at IIT Madras and build applied LLM and ML systems. In Interview Intelligence AI, Gemini’s output
            is held to a Zod JSON schema before anything reaches the user, behind JWT auth, a token blacklist and rate limiting.
            For Messy Mashup I grouped validation folds by song (5-fold StratifiedGroupKFold) so no song leaked between folds.
            My deployment agent checks the live URL after every deploy.
          </p>
          <p class="muted">{profile.aiAssisted}</p>
          <dl class="kv edu">
            <dt>Studying</dt><dd>{iitm.degree}, IIT Madras. {sentence(iitm.detail)}</dd>
            <dt>Before that</dt><dd>{school.degree}, {school.institution}. {sentence(school.detail)}</dd>
          </dl>
        </div>
        <div class="about-side">
          <h3 class="side-title">Toolkit</h3>
          <dl class="kv tools">
            {profile.skills.map((s) => (<><dt>{s.group}</dt><dd>{s.items.join(', ')}</dd></>))}
          </dl>
          <p class="more"><a class="link" href={profile.links.github}>More projects and coursework on GitHub</a></p>
        </div>
      </div>
    </div>
  </section>

  <section id="terminal" class="block" aria-labelledby="term-title">
    <div class="wrap">
      <h2 id="term-title" class="section-title" data-reveal>Ask the site</h2>
      <p class="section-lede">
        A small terminal that knows this site. Type <code>help</code>, or ask about my work; answers come only from the facts
        here. It is on every page: use the button in the corner or press <kbd>/</kbd>.
      </p>
      <div class="ask" data-term-ui hidden>
        <button class="ask-bar" type="button" data-term-open>
          <span class="who">visitor@kbxai:~$</span><span class="ph">ask anything about my work</span><kbd aria-hidden="true">/</kbd>
        </button>
        <ul class="ask-try" aria-label="Commands to try">
          <li><button type="button" data-term-cmd="help">help</button></li>
          <li><button type="button" data-term-cmd="ls projects">ls projects</button></li>
          <li><button type="button" data-term-cmd="cat messy-mashup">cat messy-mashup</button></li>
          <li><button type="button" data-term-cmd="whoami --face">whoami --face</button></li>
          <li><button type="button" data-term-cmd="ask what is your strongest project?">ask what is your strongest project?</button></li>
        </ul>
      </div>
    </div>
  </section>

  <section id="contact" class="block contact" aria-labelledby="contact-title">
    <div class="wrap">
      <h2 id="contact-title" class="section-title" data-reveal>Contact</h2>
      <p class="section-lede">Email is the fastest way to reach me. {sentence(profile.availability)}</p>
      <a class="mail" href={`mailto:${profile.email}`}>{profile.email}</a>
      <dl class="kv">
        <dt>Phone</dt><dd><a href={profile.phoneHref}>{profile.phone}</a></dd>
        <dt>GitHub</dt><dd><a href={profile.links.github}>github.com/kbxai</a></dd>
        <dt>LinkedIn</dt><dd><a href={profile.links.linkedin}>linkedin.com/in/kbxai</a></dd>
        <dt>Based in</dt><dd>{profile.location}</dd>
      </dl>
    </div>
  </section>
</Base>

<style>
  /* Hero: the name and the portrait are the one moment on the page */
  .hero { min-height: 100svh; display: grid; align-items: end; padding-top: 68px; overflow: clip; }
  .art { position: absolute; top: 0; bottom: 0; right: 0; width: min(58vw, 980px); }
  .art::after { content: ''; position: absolute; inset: 0; pointer-events: none; background: linear-gradient(90deg, var(--ink) 0%, transparent 22%), linear-gradient(0deg, var(--ink) 0%, transparent 18%); }
  .hero-copy { position: relative; width: 100%; padding-bottom: clamp(5rem, 12vh, 7rem); }
  .hero-copy > * { max-width: 40rem; }
  .kicker { color: var(--muted); margin-bottom: 1.2rem; }
  .name { font-size: var(--fs-display); line-height: 0.88; letter-spacing: -0.04em; margin: 0 0 1.8rem; max-width: none; }
  .name .line { display: block; overflow: clip; padding-bottom: 0.12em; margin-bottom: -0.12em; }
  .name .indent { padding-left: 0.6em; }
  .lead { font-size: var(--fs-lg); color: var(--muted); max-width: 36rem; margin-bottom: 2rem; }

  /* Hero entrance: one short rise, no blur (text is in the DOM from the first byte, so LCP is unaffected) */
  @media (prefers-reduced-motion: no-preference) {
    :global(:root:not([data-motion='paused'])) .rise { animation: rise 420ms var(--ease) both; animation-delay: var(--d, 0ms); }
    .name .rise { display: inline-block; animation-name: rise-line; }
  }
  @keyframes rise { from { opacity: 0; transform: translateY(10px); } }
  @keyframes rise-line { from { transform: translateY(100%); } }

  @media (max-width: 860px) {
    .hero { min-height: 0; grid-template-rows: auto auto; padding-top: 60px; }
    .art { position: relative; width: 100%; height: min(92vw, 520px); }
    .art::after { background: linear-gradient(0deg, var(--ink) 0%, transparent 30%); }
    .hero-copy { margin-top: -4.5rem; padding-bottom: 1rem; }
  }

  .rows { border-bottom: 1px solid var(--line); }

  /* About */
  .about { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr); gap: 3rem clamp(2rem, 6vw, 5rem); border-top: 1px solid var(--line); padding-top: 2.5rem; margin-top: clamp(2rem, 5vw, 3rem); }
  .about-main { display: grid; gap: 1.4rem; align-content: start; }
  .about-lead { font-size: var(--fs-lg); max-width: 40ch; }
  .about-main .muted { max-width: 52ch; }
  .edu { grid-template-columns: minmax(0, 8rem) minmax(0, 1fr); margin-top: 0.6rem; }
  .side-title { font-size: var(--fs-lg); font-family: var(--sans); font-weight: 600; letter-spacing: 0; margin-bottom: 1.2rem; }
  .tools { grid-template-columns: minmax(0, 11rem) minmax(0, 1fr); gap: 0.6rem 1.5rem; font-size: var(--fs-sm); }
  .more { margin-top: 2rem; font-size: var(--fs-sm); }
  @media (max-width: 860px) { .about { grid-template-columns: 1fr; } }

  /* Ask */
  .ask { display: grid; gap: 1.1rem; max-width: 52rem; }
  .ask[hidden] { display: none; }
  .ask-bar { display: flex; align-items: center; gap: 0.9rem; width: 100%; padding: 1.05rem 1.2rem; border: 1px solid var(--line-2); border-radius: 14px; background: var(--ink-2); color: var(--dim); font: 400 var(--fs-sm)/1.2 var(--mono); text-align: left; cursor: text; transition: border-color var(--t-fast) var(--ease); }
  .ask-bar:hover { border-color: var(--accent); }
  .ask-bar .who { color: var(--accent); white-space: nowrap; }
  .ask-bar .ph { flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .ask-bar kbd, .section-lede kbd { font: 400 var(--fs-xs)/1 var(--mono); color: var(--muted); border: 1px solid var(--line-2); border-radius: 6px; padding: 0.22rem 0.45rem; }
  .ask-try { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 0.5rem; }
  .ask-try button { font: 400 var(--fs-xs)/1 var(--mono); color: var(--muted); background: transparent; border: 1px solid var(--line-2); border-radius: 999px; padding: 0.55rem 0.85rem; cursor: pointer; transition: color var(--t-fast) var(--ease), border-color var(--t-fast) var(--ease); }
  .ask-try button:hover { color: var(--paper); border-color: var(--accent); }
  @media (max-width: 520px) { .ask-bar .who { display: none; } }

  /* Contact */
  .mail { display: inline-block; font-family: var(--serif); font-size: var(--fs-2xl); letter-spacing: -0.02em; line-height: 1.1; text-decoration: none; margin-bottom: 3rem; background: linear-gradient(var(--accent), var(--accent)) 0 100% / 0 2px no-repeat; transition: background-size var(--t-base) var(--ease), color var(--t-fast) var(--ease); overflow-wrap: anywhere; }
  .mail:hover { background-size: 100% 2px; color: var(--paper); }
  .contact .kv { max-width: 860px; border-top: 1px solid var(--line); padding-top: 2rem; }
</style>

<script>
  import { maybeStartHero } from '../lib/hero-loader';
  maybeStartHero();
</script>
