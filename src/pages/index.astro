---
import Base from '../layouts/Base.astro';
import Prompt from '../components/Prompt.astro';
import ProjectCard from '../components/ProjectCard.astro';
import Terminal from '../components/Terminal.astro';
import profile from '../data/profile.json';
import projects from '../data/projects.json';
import github from '../data/github.json';
import thumbs from '../data/thumbs.json';

const featuredNames = new Set([
  'interview-intelligence-ai', 'Messy-Mashup-Genre-Classification', 'LLM-Powered-Code-Deployment-Agent',
  'MedSyncPro-Hospital-Management-System', 'Comment-Category-Prediction-Challenge',
]);
const otherRepos = github.repos.filter((r) => !featuredNames.has(r.name));
const thumbFor = (slug: string) => (thumbs as Record<string, { src: string; width: number; height: number }>)[slug] ?? null;
---
<Base
  title="Kartik Bajaj | AI/LLM Engineer intern | IIT Madras"
  description="Kartik Bajaj, IIT Madras BS Data Science student seeking an AI/LLM Engineer internship. Live LLM apps, Macro F1 0.954 audio classifier, projects, resume and contact."
>
  <section class="hero" aria-labelledby="whoami">
    <div class="wrap hero-grid">
      <div class="hero-text">
        <Prompt cmd="whoami" />
        <h1 id="whoami">{profile.name}</h1>
        <p class="headline">{profile.headline}</p>
        <p class="muted">IIT Madras, BS in Data Science and Applications | {profile.location}</p>
        <ul class="proof">
          {profile.proof.map((p) => <li>{p}</li>)}
        </ul>
        <p class="muted small">{profile.availability}</p>
        <div class="actions">
          <a class="btn" href="/resume/">resume</a>
          <a class="btn ghost" href="#projects">ls projects</a>
          <a class="btn ghost" href={`mailto:${profile.email}`}>email</a>
        </div>
      </div>
      <div class="hero-art" id="hero-art" aria-hidden="true">
        <img id="hero-fallback" class="art-img" src="/hero-ascii.webp" width="570" height="420" alt="" decoding="async" />
      </div>
    </div>
    <div class="wrap">
      <Terminal />
    </div>
  </section>

  <hr class="rule" />

  <section id="projects" aria-labelledby="projects-title">
    <div class="wrap">
      <Prompt cmd="ls ./projects" />
      <h2 id="projects-title">Projects</h2>
      <p class="muted">Five projects from my resume. Each has a man page with results and known limitations.</p>
      <div class="grid">
        {projects.map((p) => <ProjectCard project={p} thumb={thumbFor(p.slug)} />)}
      </div>
    </div>
  </section>

  <section id="repos" aria-labelledby="repos-title">
    <div class="wrap">
      <Prompt cmd="ls ~/repos --all" />
      <h2 id="repos-title">More on GitHub</h2>
      <p class="muted">Learning projects and coursework. Pulled from the GitHub API at build time.</p>
      <div class="table-scroll">
        <table class="ascii">
          <thead><tr><th scope="col">repo</th><th scope="col">lang</th><th scope="col">about</th></tr></thead>
          <tbody>
            {otherRepos.map((r) => (
              <tr>
                <td><a href={r.url}>{r.name}</a></td>
                <td>{r.language ?? '-'}</td>
                <td>{r.description ?? ''}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <section id="skills" aria-labelledby="skills-title">
    <div class="wrap">
      <Prompt cmd="cat skills.txt" />
      <h2 id="skills-title">Skills</h2>
      <dl class="kv">
        {profile.skills.map((s) => (<><dt>{s.group}</dt><dd>{s.items.join(', ')}</dd></>))}
      </dl>
      <p class="muted">{profile.aiAssisted}</p>
    </div>
  </section>

  <section id="education" aria-labelledby="education-title">
    <div class="wrap">
      <Prompt cmd="cat education.txt" />
      <h2 id="education-title">Education</h2>
      {profile.education.map((e) => (
        <div class="edu">
          <h3>{e.institution}</h3>
          <p>{e.degree} | <span class="muted">{e.dates}</span></p>
          <p class="amber">{e.detail}</p>
        </div>
      ))}
      <p><span class="muted">Coursework:</span> {profile.coursework.join(', ')}</p>
    </div>
  </section>

  <section id="contact" aria-labelledby="contact-title">
    <div class="wrap">
      <Prompt cmd="./contact.sh" />
      <h2 id="contact-title">Contact</h2>
      <dl class="kv">
        <dt>email</dt><dd><a href={`mailto:${profile.email}`}>{profile.email}</a></dd>
        <dt>phone</dt><dd><a href={profile.phoneHref}>{profile.phone}</a></dd>
        <dt>github</dt><dd><a href={profile.links.github}>github.com/kbxai</a></dd>
        <dt>linkedin</dt><dd><a href={profile.links.linkedin}>linkedin.com/in/kbxai</a></dd>
        <dt>location</dt><dd>{profile.location}</dd>
        <dt>open to</dt><dd>{profile.availability}</dd>
      </dl>
    </div>
  </section>
</Base>

<style>
  .hero { padding-top: 2rem; }
  .hero-grid { display: grid; gap: 24px; grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr); align-items: center; }
  .hero h1 { font-size: clamp(2.2rem, 7vw, 4rem); letter-spacing: -0.02em; }
  .headline { font-size: clamp(1.05rem, 2.6vw, 1.3rem); margin: 0.5rem 0 0.25rem; color: var(--fg); font-weight: 700; }
  .proof { margin: 1rem 0 0.75rem; padding: 0; list-style: none; }
  .proof li { padding-left: 2ch; text-indent: -2ch; margin: 0.25rem 0; }
  .proof li::before { content: '> '; color: var(--accent); }
  .small { font-size: 0.85rem; }
  .hero-art { position: relative; min-height: 340px; display: grid; place-items: center; overflow: hidden; }
  .hero-art :global(canvas) { position: absolute; inset: 0; width: 100%; height: 100%; display: block; }
  .art-img { width: 100%; height: auto; max-width: 570px; }
  .hero-art.live #hero-fallback { opacity: 0; transition: opacity 0.4s; }
  .edu { margin: 0 0 1rem; }
  .edu p { margin: 0.2rem 0; }
  @media (max-width: 820px) {
    .hero-grid { grid-template-columns: 1fr; }
    .hero-art { min-height: 220px; order: 2; }
  }
</style>

<script>
  import { maybeStartHero } from '../lib/hero-loader';
  maybeStartHero();
</script>
