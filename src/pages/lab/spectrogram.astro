---
import Base from '../../layouts/Base.astro';
import Prompt from '../../components/Prompt.astro';
import projects from '../../data/projects.json';
const mm = projects.find((p) => p.slug === 'messy-mashup')!;
const pipeline = String.raw`
  noisy 30 s mix ──> log-mel spectrogram ──┬──> ResNet-50 (ImageNet weights) ────┐
  (stems + ESC-50     (what you see below)  │                                     ├──> 60/40 ensemble + TTA ──> genre
   background noise)                        └──> Audio Spectrogram Transformer ───┘     final Macro F1 0.954
                                                 (AudioSet weights)`;
---
<Base title="Spectrogram lab | Kartik Bajaj" description="Watch audio turn into a glowing ASCII log-mel spectrogram, the input my noisy-audio genre classifier (Macro F1 0.954) learned from.">
  <article class="wrap lab" aria-labelledby="lab-title">
    <Prompt cmd="./lab/spectrogram --live" />
    <h1 id="lab-title">Spectrogram lab</h1>
    <p>
      My <a href={`/projects/${mm.slug}/`}>{mm.title}</a> model never hears music. It sees a log-mel spectrogram:
      time from left to right, low to high pitch from bottom to top, loudness as brightness. This lab draws that picture
      live, as glyphs. Turn up the noise to see the problem the project had to solve.
    </p>
    <pre class="pipe" aria-label="Model pipeline: noisy mix to log-mel spectrogram, into ResNet-50 and an Audio Spectrogram Transformer, combined in a 60/40 ensemble with test-time augmentation, final Macro F1 0.954.">{pipeline}</pre>

    <div id="lab-controls" class="controls" hidden>
      <button class="btn" type="button" id="src-synth">play synthesized mashup</button>
      <label class="btn ghost file">use your own audio file<input type="file" id="src-file" accept="audio/*" /></label>
      <button class="btn ghost" type="button" id="src-mic">use microphone</button>
      <button class="btn ghost" type="button" id="src-stop" disabled>stop</button>
      <label class="noise" for="noise">background noise <input id="noise" type="range" min="0" max="80" value="20" /> <output id="noise-out" for="noise">20%</output></label>
    </div>
    <p id="lab-status" class="muted" role="status" aria-live="polite">Press a button to start. Audio never leaves your browser.</p>
    <canvas id="spec" class="spec" aria-hidden="true"></canvas>
    <noscript><p class="muted">The live spectrogram needs JavaScript.</p></noscript>

    <h2>What this does and does not show</h2>
    <ul>
      <li>The picture is computed in your browser with the Web Audio API (2048-point FFT averaged into 48 mel bands). It is a visual of the model's input type, not the model itself.</li>
      <li>No predictions are shown here. To classify a real clip, use the <a href={mm.links.demo}>live demo on Hugging Face</a> (it may take a minute to wake up).</li>
      <li>The synthesized track is generated by code (chords, kick, hi-hat and white noise), so there is no copyrighted audio on this page.</li>
    </ul>
  </article>
</Base>
<style>
  .lab { padding-top: 2rem; }
  .lab h1 { font-size: clamp(1.8rem, 5vw, 2.6rem); margin-bottom: 0.75rem; }
  .lab h2 { font-size: 1.05rem; margin: 2rem 0 0.5rem; }
  .pipe { color: var(--muted); font-size: clamp(9px, 1.4vw, 13px); overflow-x: auto; padding: 8px 0; margin: 1rem 0; }
  .controls { display: flex; flex-wrap: wrap; gap: 10px; align-items: center; margin: 1rem 0 0.5rem; }
  .controls button { font: inherit; cursor: pointer; background: none; }
  .controls button:disabled { opacity: 0.45; cursor: default; }
  .file { position: relative; cursor: pointer; }
  .file input { position: absolute; inset: 0; opacity: 0; cursor: pointer; }
  .file:focus-within { outline: 2px solid var(--accent2); outline-offset: 3px; }
  .noise { display: inline-flex; gap: 8px; align-items: center; color: var(--muted); }
  .noise input { accent-color: var(--accent2); }
  .spec { display: block; width: 100%; height: clamp(220px, 42vw, 420px); background: #070a08; border: 1px solid var(--border-strong); }
</style>
<script>
  import { initLab } from '../../lib/spectrogram';
  initLab();
</script>
