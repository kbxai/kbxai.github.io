---
// Disabled (leading underscore = not built). Enable by renaming to agent-replay.astro once
// src/data/agent-log.json holds a REAL, redacted log from one run of the LLM Code Deployment Agent:
// [{ "t": <ms since start>, "text": "<line>", "kind": "plain|muted|accent|amber|error" }, ...]
// Never commit an invented log.
import Base from '../../layouts/Base.astro';
import Prompt from '../../components/Prompt.astro';
import log from '../../data/agent-log.json';
---
<Base title="Agent run replay | Kartik Bajaj" description="A real run of my LLM Code Deployment Agent, replayed as a terminal session.">
  <article class="wrap" style="padding-top:2rem">
    <Prompt cmd="./replay deployment-agent.log" />
    <h1>Agent run replay</h1>
    <p class="muted">A recorded run of the <a href="/projects/llm-code-deployment-agent/">LLM Code Deployment Agent</a>, secrets removed.</p>
    <pre id="replay" class="replay" aria-live="off">{log.map((l) => l.text).join('\n')}</pre>
    <button class="btn" type="button" id="replay-play">replay</button>
  </article>
  <style>.replay{border:1px solid var(--border-strong);background:#070a08;padding:12px;white-space:pre-wrap;min-height:240px}</style>
  <script>
    import log from '../../data/agent-log.json';
    import { motionAllowed } from '../../lib/motion';
    const pre = document.getElementById('replay')!;
    document.getElementById('replay-play')!.addEventListener('click', () => {
      if (!motionAllowed()) return;
      pre.textContent = '';
      for (const l of log) setTimeout(() => (pre.textContent += l.text + '\n'), Math.min(l.t, 20000) / 2);
    });
  </script>
</Base>
