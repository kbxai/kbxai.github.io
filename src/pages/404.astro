---
import Base from '../layouts/Base.astro';
---
<Base title="Page not found | Kartik Bajaj" description="This page does not exist.">
  <section class="wrap nf" aria-labelledby="nf">
    <p class="code mono" aria-hidden="true">404</p>
    <h1 id="nf">This page does not exist.</h1>
    <p class="muted">The link may be old, or the address has a typo. These pages do exist:</p>
    <ul>
      <li><a class="link" href="/">Home</a></li>
      <li><a class="link" href="/#work">Selected work</a></li>
      <li><a class="link" href="/resume/">Resume</a></li>
      <li><a class="link" href="/lab/spectrogram/">Spectrogram lab</a></li>
    </ul>
  </section>
</Base>
<style>
  .nf { padding-top: calc(68px + clamp(3rem, 10vw, 7rem)); min-height: 70vh; }
  .code { color: var(--amber); font-size: 0.9rem; margin-bottom: 1.2rem; }
  h1 { font-size: clamp(2.6rem, 7vw, 5.5rem); letter-spacing: -0.035em; margin-bottom: 1.2rem; max-width: 14ch; }
  ul { list-style: none; padding: 0; margin: 2rem 0 0; display: flex; flex-wrap: wrap; gap: 1rem 2rem; }
</style>
