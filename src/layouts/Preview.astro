---
// Minimal layout for the three hero design previews (noindex, not linked, excluded from the sitemap).
import '@fontsource/jetbrains-mono/latin-400.css';
import '@fontsource/jetbrains-mono/latin-700.css';
interface Props { title: string }
const { title } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{title}</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <style is:global>
      *, *::before, *::after { box-sizing: border-box; }
      html, body { margin: 0; }
      body { min-height: 100vh; overflow-x: hidden; -webkit-font-smoothing: antialiased; }
      a { color: inherit; }
      :focus-visible { outline: 2px solid #ffb454; outline-offset: 3px; }
      .sr-only { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
    </style>
  </head>
  <body>
    <slot />
    <script>
      import { maybeStartHero } from '../lib/hero-loader';
      import { scrambleAll } from '../lib/scramble';
      maybeStartHero('hero-art');
      scrambleAll();
    </script>
  </body>
</html>
