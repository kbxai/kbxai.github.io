---
import '@fontsource/newsreader/latin-400.css';
import '@fontsource/newsreader/latin-400-italic.css';
import '@fontsource/geist-sans/latin-400.css';
import '@fontsource/geist-sans/latin-500.css';
import '@fontsource/jetbrains-mono/latin-400.css';
import '@fontsource/jetbrains-mono/latin-700.css'; // the hero's glyph atlas is drawn at 700 (src/three/grid.ts); fetched only when it is used
import '../styles/global.css';
import profile from '../data/profile.json';
import Hud from '../components/Hud.astro';
import Terminal from '../components/Terminal.astro';
import serif400 from '@fontsource/newsreader/files/newsreader-latin-400-normal.woff2?url';
import serifItalic from '@fontsource/newsreader/files/newsreader-latin-400-italic.woff2?url';
import sans400 from '@fontsource/geist-sans/files/geist-sans-latin-400-normal.woff2?url';

interface Props {
  title: string;
  description: string;
  preloadImage?: string;
}
const { title, description, preloadImage } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const og = new URL('/og.png', Astro.site).href;
const person = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: profile.name,
  url: Astro.site?.href,
  email: `mailto:${profile.email}`,
  jobTitle: 'Data Science student seeking an AI/LLM Engineer internship',
  alumniOf: { '@type': 'CollegeOrUniversity', name: 'Indian Institute of Technology Madras' },
  address: { '@type': 'PostalAddress', addressLocality: 'Ambala', addressRegion: 'Haryana', addressCountry: 'IN' },
  sameAs: [profile.links.github, profile.links.linkedin],
};
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const nav = [
  { href: '/#work', label: 'Work', match: '' },
  { href: '/lab/spectrogram/', label: 'Lab', match: '/lab/spectrogram', cls: 'hide-sm' },
  { href: '/resume/', label: 'Resume', match: '/resume' },
  { href: '/#contact', label: 'Contact', match: '' },
];
const [first, ...rest] = profile.name.split(' ');
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#0b0a12" />
    <meta name="color-scheme" content="dark" />
    <link rel="preload" href={serif400} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={serifItalic} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={sans400} as="font" type="font/woff2" crossorigin />
    {preloadImage && <link rel="preload" as="image" href={preloadImage} fetchpriority="high" />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={og} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={og} />
    <script type="application/ld+json" set:html={JSON.stringify(person)} />
    <script is:inline>
      try {
        if (localStorage.getItem('kb.motion') === 'paused') document.documentElement.dataset.motion = 'paused';
      } catch (e) {}
      // a paused visitor gets plain navigations: skip the cross-document view transition on both pages
      var skipVT = function (e) {
        if (e.viewTransition && document.documentElement.dataset.motion === 'paused') e.viewTransition.skipTransition();
      };
      window.addEventListener('pageswap', skipVT);
      window.addEventListener('pagereveal', skipVT);
    </script>
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <div class="progress" aria-hidden="true"></div>
    <header class="top" id="top">
      <div class="wrap">
        <a class="brand" href="/">{first} <em>{rest.join(' ')}</em></a>
        <nav aria-label="Main">
          {nav.map((n) => (
            <a class={n.cls} href={n.href} aria-current={n.match && path === n.match ? 'page' : undefined}>{n.label}</a>
          ))}
        </nav>
      </div>
    </header>
    <Terminal />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <footer class="site">
      <div class="wrap">
        <div class="row">
          <p>{profile.name}, {profile.location}. <a href={`mailto:${profile.email}`}>{profile.email}</a></p>
          <p><a href={profile.links.github}>GitHub</a> <span aria-hidden="true">/</span> <a href={profile.links.linkedin}>LinkedIn</a> <span aria-hidden="true">/</span> <a href="/resume/">Resume</a></p>
        </div>
        <p class="note">Built with Astro and three.js, with AI coding tools. Every number on this site is checked against my resume at build time.</p>
        <Hud />
      </div>
    </footer>
    <button class="motion-pill" type="button" id="motion-toggle" aria-pressed="false" style="visibility:hidden">
      <span class="dot" aria-hidden="true"></span><span class="txt">Motion on</span>
    </button>
    <script>
      import { initMotionToggle } from '../lib/motion';
      import { initReveal } from '../lib/reveal';
      initMotionToggle();
      initReveal();
      const top = document.getElementById('top');
      const onScroll = () => top?.classList.toggle('scrolled', window.scrollY > 24);
      onScroll();
      window.addEventListener('scroll', onScroll, { passive: true });
      const idle = (window as Window & { requestIdleCallback?: (cb: () => void) => number }).requestIdleCallback ?? ((cb: () => void) => setTimeout(cb, 200));
      idle(() => import('../lib/smooth').then((m) => m.initSmooth()));
    </script>
  </body>
</html>

<style>
  footer.site .note { margin-top: 1rem; max-width: 70ch; }
</style>
