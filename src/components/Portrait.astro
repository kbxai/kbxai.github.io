---
// ASCII self-portrait: static glowing fallback image, upgraded to the live WebGL renderer by src/lib/hero-loader.ts.
interface Props { id?: string; class?: string }
const { id = 'hero-art', class: cls = '' } = Astro.props;
---
<div class={`portrait ${cls}`} id={id} aria-hidden="true">
  <img id="hero-fallback" class="portrait-fallback" src="/portrait/fallback.webp" width="736" height="786" alt="" decoding="async" fetchpriority="low" />
</div>
<style>
  .portrait { position: relative; width: 100%; aspect-ratio: 120 / 123; overflow: hidden; }
  .portrait-fallback { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: contain; transition: opacity 0.5s; }
  .portrait.live .portrait-fallback { opacity: 0; }
  .portrait :global(canvas) { position: absolute; inset: 0; width: 100%; height: 100%; display: block; }
</style>
