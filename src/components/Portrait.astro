---
// Hero portrait: a still render of the glyph field (also the no-WebGL and reduced-motion view),
// upgraded to the live 3D field by src/lib/hero-loader.ts after the page has loaded.
import meta from '../data/field-meta.json';
interface Props { id?: string; class?: string }
const { id = 'hero-art', class: cls = '' } = Astro.props;
const [w, h] = meta.still;
---
<div class={`portrait ${cls}`} id={id} aria-hidden="true">
  <img id="hero-fallback" class="portrait-still" src="/field/still.webp" width={w} height={h} alt="" fetchpriority="high" />
</div>
<style>
  .portrait { position: relative; width: 100%; height: 100%; }
  /* the still is captured from the live render at rest (scripts/portrait/capture_still.py), so the swap is
     instant: a cross-fade would draw both copies of each glyph at once and flash brighter */
  .portrait-still { position: absolute; inset: 2%; width: 96%; height: 96%; object-fit: contain; }
  .portrait.live .portrait-still { visibility: hidden; }
  .portrait :global(canvas) { position: absolute; inset: 0; width: 100%; height: 100%; display: block; }
</style>
