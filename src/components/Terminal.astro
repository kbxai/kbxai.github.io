---
// Interactive shell. Hidden without JS (all its content already exists as normal page sections).
---
<div class="term" id="term" hidden>
  <div class="term-bar" aria-hidden="true"><span></span><span></span><span></span><em>visitor@kbxai: ~</em></div>
  <div class="term-log" id="term-log" role="log" aria-live="polite" aria-label="Terminal output"></div>
  <form class="term-form" id="term-form" autocomplete="off">
    <label for="term-input"><span class="user">visitor@kbxai</span>:<span class="muted">~</span>$</label>
    <input id="term-input" name="cmd" type="text" spellcheck="false" autocapitalize="off" enterkeyhint="send"
      aria-describedby="term-hint" maxlength="320" />
  </form>
  <p class="sr-only" id="term-hint">Type a command such as help, ls projects, cat messy-mashup, or ask followed by a question, then press Enter.</p>
</div>

<style>
  .term { border: 1px solid var(--line-2); border-radius: 16px; background: linear-gradient(180deg, var(--ink-3), var(--ink-2)); overflow: hidden; box-shadow: 0 30px 80px -40px rgba(0, 0, 0, 0.8), 0 0 0 1px rgba(255, 255, 255, 0.02) inset; font-family: var(--mono); }
  .term-bar { display: flex; align-items: center; gap: 7px; padding: 12px 16px; border-bottom: 1px solid var(--line); }
  .term-bar span { width: 10px; height: 10px; border-radius: 50%; background: var(--line-2); }
  .term-bar em { margin-left: 10px; color: var(--dim); font-style: normal; font-size: 0.78rem; }
  .term-log { padding: 16px 18px 0; max-height: 340px; overflow-y: auto; font-size: 0.86rem; line-height: 1.6; white-space: pre-wrap; overflow-wrap: anywhere; color: var(--paper); }
  .term-log :global(p) { margin: 0; min-height: 1.5em; }
  .term-log :global(a) { color: var(--amber); }
  .term-log :global(.k-muted) { color: var(--muted); }
  .term-log :global(.k-accent) { color: var(--paper); }
  .term-log :global(.k-amber) { color: var(--amber); }
  .term-log :global(.k-error) { color: var(--error); }
  .term-log :global(.k-echo) { color: var(--paper); }
  .term-log :global(pre.face) { margin: 6px 0; font-size: clamp(4px, 0.95vw, 8.5px); line-height: 1.08; color: var(--paper); overflow-x: auto; white-space: pre; text-shadow: 0 0 6px rgba(239, 233, 223, 0.25); }
  .term-form { display: flex; gap: 10px; align-items: center; padding: 10px 18px 16px; }
  .term-form label { color: var(--dim); white-space: nowrap; font-size: 0.86rem; }
  .term-form .user { color: var(--amber); }
  .term-form input { flex: 1; min-width: 0; background: transparent; border: 0; border-bottom: 1px solid var(--line-2); color: var(--paper); font: inherit; font-size: 0.92rem; padding: 6px 2px; caret-color: var(--amber); }
  .term-form input:focus-visible { outline: none; border-bottom-color: var(--amber); }
</style>

<script>
  import { initTerminal } from '../scripts/terminal/ui';
  initTerminal();
</script>
