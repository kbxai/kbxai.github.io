---
// Site-wide terminal: a launcher pill on every page opens it in a modal dialog (also "/" or Ctrl/Cmd+K).
// Hidden without JS (all its content already exists as normal page sections).
---
<button class="term-launch" type="button" id="term-launch" aria-haspopup="dialog" aria-controls="term-dialog" hidden>
  <span class="prompt" aria-hidden="true">&gt;_</span><span>Ask the site</span><kbd aria-hidden="true">/</kbd>
</button>

<dialog class="term-dialog" id="term-dialog" aria-labelledby="term-dialog-title" data-lenis-prevent>
  <div class="term" id="term" hidden>
    <div class="term-bar">
      <span class="dots" aria-hidden="true"><i></i><i></i><i></i></span>
      <h2 id="term-dialog-title">Ask the site</h2>
      <span class="hint" aria-hidden="true">Esc to close</span>
      <button class="term-close" type="button" id="term-close" aria-label="Close the terminal">
        <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M4 4l8 8M12 4l-8 8" stroke="currentColor" stroke-width="1.5" /></svg>
      </button>
    </div>
    <div class="term-log" id="term-log" role="log" aria-live="polite" aria-label="Terminal output"></div>
    <form class="term-form" id="term-form" autocomplete="off">
      <label for="term-input"><span class="user">visitor@kbxai</span>:<span class="muted">~</span>$</label>
      <input id="term-input" name="cmd" type="text" spellcheck="false" autocapitalize="off" enterkeyhint="send"
        aria-describedby="term-hint" maxlength="320" />
    </form>
    <p class="sr-only" id="term-hint">Type a command such as help, ls projects, cat messy-mashup, or ask followed by a question, then press Enter.</p>
  </div>
</dialog>

<style>
  .term-launch { position: fixed; left: 18px; bottom: 18px; z-index: 45; display: inline-flex; align-items: center; gap: 0.6rem; padding: 0.5rem 0.6rem 0.5rem 0.85rem; border-radius: 999px; background: rgba(19, 17, 27, 0.82); backdrop-filter: blur(10px); -webkit-backdrop-filter: blur(10px); border: 1px solid var(--line-2); color: var(--paper); font: 600 var(--fs-xs)/1 var(--sans); cursor: pointer; transition: border-color var(--t-fast) var(--ease), color var(--t-fast) var(--ease); }
  .term-launch[hidden] { display: none; }
  .term-launch:hover { border-color: var(--amber); }
  .term-launch .prompt { font-family: var(--mono); color: var(--amber); font-size: var(--fs-xs); }
  .term-launch kbd { font: 400 var(--fs-xs)/1 var(--mono); color: var(--dim); border: 1px solid var(--line-2); border-radius: 6px; padding: 0.22rem 0.42rem; }
  @media (hover: none) { .term-launch kbd { display: none; } .term-launch { padding-right: 0.95rem; } }

  .term-dialog { padding: 0; border: 0; background: transparent; color: inherit; width: min(760px, calc(100vw - 32px)); max-width: none; max-height: min(78vh, 720px); overflow: visible; }
  .term-dialog::backdrop { background: rgba(6, 5, 11, 0.62); backdrop-filter: blur(6px); -webkit-backdrop-filter: blur(6px); }
  .term-dialog[open] { display: flex; }
  .term-dialog[open] .term { animation: term-in 220ms var(--ease) both; }
  @keyframes term-in { from { opacity: 0; transform: translateY(10px) scale(0.985); } }
  :global(:root[data-motion='paused']) .term-dialog[open] .term { animation: none; }
  @media (prefers-reduced-motion: reduce) { .term-dialog[open] .term { animation: none; } }

  .term { flex: 1; display: flex; flex-direction: column; min-height: 0; max-height: inherit; border: 1px solid var(--line-2); border-radius: 16px; background: var(--ink-2); overflow: hidden; box-shadow: 0 40px 120px -40px rgba(0, 0, 0, 0.9), 0 0 0 1px rgba(255, 255, 255, 0.02) inset; font-family: var(--mono); }
  .term-bar { display: flex; align-items: center; gap: 12px; padding: 10px 10px 10px 16px; border-bottom: 1px solid var(--line); }
  .dots { display: inline-flex; gap: 7px; }
  .dots i { width: 10px; height: 10px; border-radius: 50%; background: var(--line-2); }
  .term-bar h2 { font: 400 var(--fs-xs)/1 var(--mono); color: var(--muted); letter-spacing: 0; margin: 0; }
  .term-bar .hint { margin-left: auto; font-size: var(--fs-xs); color: var(--dim); }
  .term-close { width: 32px; height: 32px; display: grid; place-items: center; border-radius: 8px; border: 1px solid transparent; background: transparent; color: var(--muted); cursor: pointer; }
  .term-close:hover { color: var(--paper); border-color: var(--line-2); }
  .term-close svg { width: 15px; height: 15px; }
  .term-log { flex: 1; min-height: 160px; padding: 16px 18px 0; overflow-y: auto; overscroll-behavior: contain; font-size: var(--fs-sm); line-height: 1.6; white-space: pre-wrap; overflow-wrap: anywhere; color: var(--paper); }
  .term-log :global(p) { margin: 0; min-height: 1.5em; }
  .term-log :global(a) { color: var(--amber); }
  .term-log :global(.k-muted) { color: var(--muted); }
  .term-log :global(.k-accent) { color: var(--paper); }
  .term-log :global(.k-amber) { color: var(--amber); }
  .term-log :global(.k-error) { color: var(--error); }
  .term-log :global(.k-echo) { color: var(--paper); }
  .term-log :global(pre.face) { margin: 6px 0; font-size: clamp(4px, 0.95vw, 7.5px); line-height: 1.08; color: var(--paper); overflow-x: auto; white-space: pre; }
  .term-form { display: flex; gap: 10px; align-items: center; padding: 10px 18px 16px; }
  .term-form label { color: var(--dim); white-space: nowrap; font-size: var(--fs-sm); }
  .term-form .user { color: var(--amber); }
  .term-form input { flex: 1; min-width: 0; background: transparent; border: 0; border-bottom: 1px solid var(--line-2); color: var(--paper); font: inherit; font-size: var(--fs-sm); padding: 6px 2px; caret-color: var(--amber); }
  .term-form input:focus-visible { outline: none; border-bottom-color: var(--amber); }

  @media (max-width: 640px) {
    .term-dialog { width: 100vw; max-height: 86vh; margin: auto 0 0; }
    .term { border-radius: 16px 16px 0 0; border-bottom: 0; }
    .term-bar .hint { display: none; }
    .term-bar h2 { margin-right: auto; }
  }
  @media print { .term-launch, .term-dialog { display: none !important; } }
</style>

<script>
  import { initTerminal } from '../scripts/terminal/ui';
  initTerminal();
</script>
